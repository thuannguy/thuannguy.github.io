---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <article class="container container--narrow page">
    <header class="page__header">
      <h1>Page not found</h1>
    </header>
    <div class="prose">
      <p>Sorry, the page you were looking for doesn't exist. It may have moved during the site redesign.</p>
      <ul>
        <li><a href="/">Go to the homepage</a></li>
        <li><a href="/blog/">Browse all blog posts</a></li>
      </ul>
    </div>
  </article>
</Base>
