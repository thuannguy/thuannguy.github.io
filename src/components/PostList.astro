---
import { formatDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  summaries?: boolean;
}
const { posts, summaries = false } = Astro.props;
---
<ul class="post-list">
  {posts.map((post) => (
    <li class="post-list__item">
      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
      <div>
        <a class="post-list__title" href={post.url}>{post.data.title}</a>
        {summaries && post.summary && <p class="post-list__excerpt">{post.summary}</p>}
      </div>
    </li>
  ))}
</ul>
