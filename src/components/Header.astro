---
import { SITE } from '../site';
const path = Astro.url.pathname;
const isCurrent = (url: string) => (url === '/' ? path === '/' : path.startsWith(url));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">TN</span>
      <span class="brand__name">{SITE.author.name}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      {SITE.navigation.map((item) => (
        <a href={item.url} aria-current={isCurrent(item.url) ? 'page' : undefined}>{item.title}</a>
      ))}
    </nav>
  </div>
</header>
